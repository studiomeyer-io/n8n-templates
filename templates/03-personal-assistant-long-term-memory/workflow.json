      "id": "pa-1-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        280
      ],
      "webhookId": "personal-assistant-tg"
